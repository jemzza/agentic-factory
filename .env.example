# Copy to .env (never commit .env).
# Path to the Claude Code CLI; defaults to `claude` on PATH.
# CLAUDE_BIN=/Users/you/.local/bin/claude
# Where target-repo clones and agent worktrees live. Must be OUTSIDE this repo.
# FACTORY_WORKDIR=~/agentic-factory-work
# Path to the OpenCode CLI; defaults to this repo's node_modules/.bin/opencode.
# OPENCODE_BIN=/path/to/opencode
# Provider key for the OpenCode reviewer (roles.reviewer.keyEnv in factory.config.ts).
# Passed ONLY to the OpenCode process; never to Claude Code or the sandbox; masked in logs.
# Use a dedicated key with a spending limit.
# OPENAI_API_KEY=sk-placeholder
# Fine-grained GitHub token for `npm run factory:watch`: only the repositories in
# projects.yaml; permissions Issues RW, Pull requests RW, Contents RW (Metadata R).
# Passed ONLY to the factory's own gh/git processes; never to agents or the sandbox; masked.
# FACTORY_GITHUB_TOKEN=github_pat_placeholder
