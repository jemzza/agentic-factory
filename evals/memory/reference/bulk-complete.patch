new file mode 100644
index 0000000..3cb9018
--- /dev/null
+++ b/tests/bulk-complete.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { createTask, deleteTask, setup } from "./helpers.js";
+
+describe("POST /tasks/bulk-complete", () => {
+  it("marks tasks done in ids order", async () => {
+    const { app } = setup();
+    const a = await createTask(app, { title: "A" });
+    const b = await createTask(app, { title: "B" });
+    const res = await app.inject({ method: "POST", url: "/tasks/bulk-complete", payload: { ids: [b.id, a.id] } });
+    expect(res.statusCode).toBe(200);
+    expect(res.json().items.map((t: { id: string }) => t.id)).toEqual([b.id, a.id]);
+  });
+
+  it("validates ids (empty, duplicates, more than 50) and changes nothing on errors", async () => {
+    const { app } = setup();
+    const a = await createTask(app, { title: "A" });
+    for (const ids of [[], [a.id, a.id], Array.from({ length: 51 }, (_, i) => `id-${i}`)]) {
+      const res = await app.inject({ method: "POST", url: "/tasks/bulk-complete", payload: { ids } });
+      expect(res.statusCode).toBe(400);
+    }
+    expect((await app.inject({ method: "POST", url: "/tasks/bulk-complete", payload: { ids: [a.id, "nope"] } })).statusCode).toBe(404);
+    const b = await createTask(app, { title: "B" });
+    await deleteTask(app, b.id);
+    expect((await app.inject({ method: "POST", url: "/tasks/bulk-complete", payload: { ids: [a.id, b.id] } })).statusCode).toBe(409);
+    expect((await app.inject({ method: "GET", url: `/tasks/${a.id}` })).json().status).toBe("todo");
+  });
+});
