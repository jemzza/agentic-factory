+  /** Marks every listed task done, all or nothing: every id is checked before any save. */
+  async bulkComplete(ids: readonly string[]): Promise<Task[]> {
+    const tasks: Task[] = [];
+    for (const id of ids) tasks.push(await this.getMutable(id));
+    const now = this.deps.clock();
+    const done = tasks.map((t): Task => ({ ...t, status: "done", updatedAt: now }));
+    for (const t of done) await this.deps.repository.save(t);
+    return done;
+  }
