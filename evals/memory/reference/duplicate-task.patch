diff --git a/tests/duplicate-task.test.ts b/tests/duplicate-task.test.ts
new file mode 100644
index 0000000..9c5b6fe
--- /dev/null
+++ b/tests/duplicate-task.test.ts
@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vitest";
+import { createTask, deleteTask, setup } from "./helpers.js";
+
+describe("POST /tasks/:id/duplicate", () => {
+  it("creates a copy titled '<title> (copy)' with status todo", async () => {
+    const { app } = setup();
+    const t = await createTask(app, { title: "Ship", description: "v1", status: "done" });
+    const res = await app.inject({ method: "POST", url: `/tasks/${t.id}/duplicate` });
+    expect(res.statusCode).toBe(201);
+    expect(res.json()).toMatchObject({ title: "Ship (copy)", description: "v1", status: "todo" });
+  });
+
+  it("returns 409 when the title is taken or the task is deleted, 404 when unknown", async () => {
+    const { app } = setup();
+    const t = await createTask(app, { title: "Ship" });
+    await createTask(app, { title: "Ship (copy)" });
+    expect((await app.inject({ method: "POST", url: `/tasks/${t.id}/duplicate` })).statusCode).toBe(409);
+    const gone = await createTask(app, { title: "Gone" });
+    await deleteTask(app, gone.id);
+    expect((await app.inject({ method: "POST", url: `/tasks/${gone.id}/duplicate` })).statusCode).toBe(409);
+    expect((await app.inject({ method: "POST", url: "/tasks/nope/duplicate" })).statusCode).toBe(404);
+  });
+
+  it("returns 400 VALIDATION_ERROR for any body field", async () => {
+    const { app } = setup();
+    const t = await createTask(app, { title: "Ship" });
+    const res = await app.inject({ method: "POST", url: `/tasks/${t.id}/duplicate`, payload: { title: "x" } });
+    expect(res.statusCode).toBe(400);
+    expect(res.json()).toMatchObject({ error: { code: "VALIDATION_ERROR" } });
+  });
+});
