diff --git a/tests/location-field.test.ts b/tests/location-field.test.ts
new file mode 100644
index 0000000..794c737
--- /dev/null
+++ b/tests/location-field.test.ts
@@ -0,0 +1,22 @@
+import { describe, expect, it } from "vitest";
+import { createTask, setup } from "./helpers.js";
+
+describe("location", () => {
+  it("defaults to null, is set, changed and cleared", async () => {
+    const { app } = setup();
+    expect((await createTask(app, { title: "A" })).location).toBeNull();
+    const t = await createTask(app, { title: "B", location: "Office" });
+    const res = await app.inject({ method: "PATCH", url: `/tasks/${t.id}`, payload: { location: null } });
+    expect(res.json().location).toBeNull();
+  });
+
+  it("is trimmed, empty means null, at most 100 characters, strings only", async () => {
+    const { app } = setup();
+    expect((await createTask(app, { title: "A", location: "  Room 1 " })).location).toBe("Room 1");
+    expect((await createTask(app, { title: "B", location: "  " })).location).toBeNull();
+    for (const location of ["x".repeat(101), 42]) {
+      const res = await app.inject({ method: "POST", url: "/tasks", payload: { title: "C", location } });
+      expect(res.statusCode).toBe(400);
+    }
+  });
+});
