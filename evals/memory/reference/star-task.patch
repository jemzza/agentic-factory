diff --git a/tests/star-task.test.ts b/tests/star-task.test.ts
new file mode 100644
index 0000000..5a93257
--- /dev/null
+++ b/tests/star-task.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { createTask, deleteTask, setup } from "./helpers.js";
+
+describe("star / unstar", () => {
+  it("toggles starred and bumps updatedAt; repeating is a no-op", async () => {
+    const { app, clock } = setup();
+    const t = await createTask(app);
+    expect(t.starred).toBe(false);
+    clock.advance(1000);
+    const s1 = await app.inject({ method: "POST", url: `/tasks/${t.id}/star` });
+    expect(s1.json()).toMatchObject({ starred: true, updatedAt: "2026-01-01T00:00:01.000Z" });
+    clock.advance(1000);
+    const s2 = await app.inject({ method: "POST", url: `/tasks/${t.id}/star` });
+    expect(s2.statusCode).toBe(200);
+    expect(s2.json()).toEqual(s1.json());
+    const u = await app.inject({ method: "POST", url: `/tasks/${t.id}/unstar` });
+    expect(u.json()).toMatchObject({ starred: false, updatedAt: "2026-01-01T00:00:02.000Z" });
+  });
+
+  it("returns 409 for a deleted task and 404 for an unknown one", async () => {
+    const { app } = setup();
+    const t = await createTask(app);
+    await deleteTask(app, t.id);
+    expect((await app.inject({ method: "POST", url: `/tasks/${t.id}/star` })).statusCode).toBe(409);
+    expect((await app.inject({ method: "POST", url: "/tasks/nope/unstar" })).statusCode).toBe(404);
+  });
+});
