diff --git a/tests/complete-task.test.ts b/tests/complete-task.test.ts
new file mode 100644
index 0000000..36ef7ff
--- /dev/null
+++ b/tests/complete-task.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+import { createTask, deleteTask, setup } from "./helpers.js";
+
+describe("POST /tasks/:id/complete", () => {
+  it("marks the task done and bumps updatedAt", async () => {
+    const { app, clock } = setup();
+    const created = await createTask(app);
+    clock.advance(1000);
+    const res = await app.inject({ method: "POST", url: `/tasks/${created.id}/complete` });
+    expect(res.statusCode).toBe(200);
+    expect(res.json()).toEqual({
+      ...created,
+      status: "done",
+      updatedAt: "2026-01-01T00:00:01.000Z",
+    });
+  });
+
+  it("returns 409 CONFLICT for a deleted task", async () => {
+    const { app } = setup();
+    const created = await createTask(app);
+    await deleteTask(app, created.id);
+    const res = await app.inject({ method: "POST", url: `/tasks/${created.id}/complete` });
+    expect(res.statusCode).toBe(409);
+    expect(res.json()).toMatchObject({ error: { code: "CONFLICT" } });
+  });
+
+  it("returns 404 NOT_FOUND for an unknown task", async () => {
+    const { app } = setup();
+    const res = await app.inject({ method: "POST", url: "/tasks/nope/complete" });
+    expect(res.statusCode).toBe(404);
+    expect(res.json()).toMatchObject({ error: { code: "NOT_FOUND" } });
+  });
+
+  it("returns 400 VALIDATION_ERROR for an unknown body key", async () => {
+    const { app } = setup();
+    const created = await createTask(app);
+    const res = await app.inject({
+      method: "POST",
+      url: `/tasks/${created.id}/complete`,
+      payload: { unexpected: true },
+    });
+    expect(res.statusCode).toBe(400);
+    expect(res.json()).toMatchObject({ error: { code: "VALIDATION_ERROR" } });
+  });
+});
