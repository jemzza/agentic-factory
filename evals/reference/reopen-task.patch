+  /** Moves a done task back to todo. Only done tasks can be reopened. */
+  async reopen(id: string): Promise<Task> {
+    const task = await this.getMutable(id);
+    if (task.status !== "done") {
+      throw conflict(`Task ${id} is not done and cannot be reopened`);
+    }
+    const reopened: Task = { ...task, status: "todo", updatedAt: this.deps.clock() };
+    await this.deps.repository.save(reopened);
+    return reopened;
+  }
