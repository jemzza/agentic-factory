diff --git a/tests/reopen-task.test.ts b/tests/reopen-task.test.ts
new file mode 100644
index 0000000..120f679
--- /dev/null
+++ b/tests/reopen-task.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from "vitest";
+import { createTask, deleteTask, setup } from "./helpers.js";
+
+describe("POST /tasks/:id/reopen", () => {
+  it("moves a done task to todo and bumps updatedAt", async () => {
+    const { app, clock } = setup();
+    const created = await createTask(app, { title: "A", status: "done" });
+    clock.advance(1000);
+    const res = await app.inject({ method: "POST", url: `/tasks/${created.id}/reopen` });
+    expect(res.statusCode).toBe(200);
+    expect(res.json()).toEqual({
+      ...created,
+      status: "todo",
+      updatedAt: "2026-01-01T00:00:01.000Z",
+    });
+  });
+
+  it("returns 409 CONFLICT for a task that is not done", async () => {
+    const { app } = setup();
+    const created = await createTask(app, { title: "A", status: "in_progress" });
+    const res = await app.inject({ method: "POST", url: `/tasks/${created.id}/reopen` });
+    expect(res.statusCode).toBe(409);
+    expect(res.json()).toMatchObject({ error: { code: "CONFLICT" } });
+  });
+
+  it("returns 409 CONFLICT for a deleted task", async () => {
+    const { app } = setup();
+    const created = await createTask(app, { title: "A", status: "done" });
+    await deleteTask(app, created.id);
+    const res = await app.inject({ method: "POST", url: `/tasks/${created.id}/reopen` });
+    expect(res.statusCode).toBe(409);
+  });
+
+  it("returns 404 NOT_FOUND for an unknown task", async () => {
+    const { app } = setup();
+    const res = await app.inject({ method: "POST", url: "/tasks/nope/reopen" });
+    expect(res.statusCode).toBe(404);
+    expect(res.json()).toMatchObject({ error: { code: "NOT_FOUND" } });
+  });
+});
