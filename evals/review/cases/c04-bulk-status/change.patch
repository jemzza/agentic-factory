+  /**
+   * Sets the same status on several tasks atomically: every task is loaded and checked
+   * before any is saved, so a missing (404) or deleted (409) task changes nothing.
+   */
+  async bulkSetStatus(ids: readonly string[], status: TaskStatus): Promise<Task[]> {
+    const tasks: Task[] = [];
+    for (const id of ids) tasks.push(await this.getMutable(id));
+    const now = this.deps.clock();
+    const updated = tasks.map((task): Task => ({ ...task, status, updatedAt: now }));
+    for (const task of updated) await this.deps.repository.save(task);
+    return updated;
+  }
+
