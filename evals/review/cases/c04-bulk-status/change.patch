diff --git a/tests/bulk-status.test.ts b/tests/bulk-status.test.ts
new file mode 100644
index 0000000..3c0e712
--- /dev/null
+++ b/tests/bulk-status.test.ts
@@ -0,0 +1,61 @@
+import { describe, expect, it } from "vitest";
+import { createTask, deleteTask, setup } from "./helpers.js";
+
+describe("POST /tasks/bulk-status", () => {
+  it("updates every task and returns them in ids order", async () => {
+    const { app, clock } = setup();
+    const a = await createTask(app, { title: "A" });
+    const b = await createTask(app, { title: "B" });
+    clock.advance(1000);
+    const res = await app.inject({
+      method: "POST",
+      url: "/tasks/bulk-status",
+      payload: { ids: [b.id, a.id], status: "done" },
+    });
+    expect(res.statusCode).toBe(200);
+    const items = res.json<{ items: { id: string; status: string; updatedAt: string }[] }>().items;
+    expect(items.map((t) => t.id)).toEqual([b.id, a.id]);
+    expect(items.every((t) => t.status === "done")).toBe(true);
+    expect(items.every((t) => t.updatedAt === "2026-01-01T00:00:01.000Z")).toBe(true);
+  });
+
+  it.each([
+    ["empty ids", { ids: [], status: "done" }],
+    ["duplicate ids", { ids: ["task-1", "task-1"], status: "done" }],
+    ["unknown status", { ids: ["task-1"], status: "nope" }],
+  ])("rejects %s with 400 VALIDATION_ERROR", async (_name, payload) => {
+    const { app } = setup();
+    await createTask(app);
+    const res = await app.inject({ method: "POST", url: "/tasks/bulk-status", payload });
+    expect(res.statusCode).toBe(400);
+    expect(res.json()).toMatchObject({ error: { code: "VALIDATION_ERROR" } });
+  });
+
+  it("is atomic: an unknown id → 404 and nothing changes", async () => {
+    const { app } = setup();
+    const a = await createTask(app, { title: "A" });
+    const res = await app.inject({
+      method: "POST",
+      url: "/tasks/bulk-status",
+      payload: { ids: [a.id, "nope"], status: "done" },
+    });
+    expect(res.statusCode).toBe(404);
+    const after = await app.inject({ method: "GET", url: `/tasks/${a.id}` });
+    expect(after.json()).toEqual(a);
+  });
+
+  it("is atomic: a deleted task → 409 and nothing changes", async () => {
+    const { app } = setup();
+    const a = await createTask(app, { title: "A" });
+    const d = await createTask(app, { title: "D" });
+    await deleteTask(app, d.id);
+    const res = await app.inject({
+      method: "POST",
+      url: "/tasks/bulk-status",
+      payload: { ids: [a.id, d.id], status: "done" },
+    });
+    expect(res.statusCode).toBe(409);
+    const after = await app.inject({ method: "GET", url: `/tasks/${a.id}` });
+    expect(after.json()).toEqual(a);
+  });
+});
