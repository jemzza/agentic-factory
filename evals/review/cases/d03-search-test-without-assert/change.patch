index 0000000..d4ec729
--- /dev/null
+++ b/tests/search-tasks.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vitest";
+import type { TaskDto } from "../src/domain/task.js";
+import { createTask, deleteTask, setup } from "./helpers.js";
+
+async function search(app: ReturnType<typeof setup>["app"], query: string) {
+  const res = await app.inject({ method: "GET", url: `/tasks?${query}` });
+  return { status: res.statusCode, body: res.json<{ items: TaskDto[] }>() };
+}
+
+describe("GET /tasks?q=", () => {
+  it("matches a case-insensitive title substring", async () => {
+    const { app } = setup();
+    await createTask(app, { title: "Write Docs" });
+    await createTask(app, { title: "Deploy" });
+    const res = await search(app, "q=docs");
+    expect(res.body.items.map((t) => t.title)).toEqual(["Write Docs"]);
+  });
+
+  it("matches regex metacharacters literally", async () => {
+    const { app } = setup();
+    await createTask(app, { title: "Learn C++" });
+    await createTask(app, { title: "Learn C" });
+    await search(app, `q=${encodeURIComponent("c++")}`);
+  });
+
+  it("combines with status and excludes deleted tasks", async () => {
+    const { app } = setup();
+    const a = await createTask(app, { title: "docs a", status: "done" });
+    await createTask(app, { title: "docs b", status: "done" });
+    await createTask(app, { title: "docs c", status: "todo" });
+    await deleteTask(app, a.id);
+    const res = await search(app, "q=docs&status=done");
+    expect(res.body.items.map((t) => t.title)).toEqual(["docs b"]);
+  });
+
+  it.each(["q=", "q=%20%20", `q=${"x".repeat(101)}`])(
+    "rejects %s with 400 VALIDATION_ERROR",
+    async (query) => {
+      const { app } = setup();
+      const res = await search(app, query);
+      expect(res.status).toBe(400);
+      expect(res.body).toMatchObject({ error: { code: "VALIDATION_ERROR" } });
+    },
+  );
+});
