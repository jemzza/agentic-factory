+import { describe, expect, it } from "vitest";
+import type { TaskDto } from "../src/domain/task.js";
+import { createTask, setup } from "./helpers.js";
+
+async function titles(app: ReturnType<typeof setup>["app"], query: string) {
+  const res = await app.inject({ method: "GET", url: `/tasks${query}` });
+  expect(res.statusCode).toBe(200);
+  return res.json<{ items: TaskDto[] }>().items.map((t) => t.title);
+}
+
+describe("GET /tasks sorting", () => {
+  it("sorts by title case-insensitively in both directions", async () => {
+    const { app, clock } = setup();
+    await createTask(app, { title: "banana" });
+    clock.advance(1);
+    await createTask(app, { title: "Apple" });
+    expect(await titles(app, "?sort=title")).toEqual(["Apple", "banana"]);
+    expect(await titles(app, "?sort=title&order=desc")).toEqual(["banana", "Apple"]);
+  });
+
+  it("sorts by createdAt desc and keeps creation order on ties", async () => {
+    const { app, clock } = setup();
+    await createTask(app, { title: "a" });
+    await createTask(app, { title: "b" });
+    clock.advance(1);
+    await createTask(app, { title: "c" });
+    expect(await titles(app, "?order=desc")).toEqual(["c", "a", "b"]);
+  });
+
+  it("sorts by updatedAt", async () => {
+    const { app, clock } = setup();
+    const a = await createTask(app, { title: "a" });
+    clock.advance(1);
+    await createTask(app, { title: "b" });
+    clock.advance(1);
+    await app.inject({ method: "PATCH", url: `/tasks/${a.id}`, payload: { status: "done" } });
+    expect(await titles(app, "?sort=updatedAt")).toEqual(["b", "a"]);
+  });
+
+  it.each(["?sort=priority", "?order=up"])("rejects %s", async (query) => {
+    const { app } = setup();
+    const res = await app.inject({ method: "GET", url: `/tasks${query}` });
+    expect(res.statusCode).toBe(400);
+    expect(res.json()).toMatchObject({ error: { code: "VALIDATION_ERROR" } });
+  });
+});
