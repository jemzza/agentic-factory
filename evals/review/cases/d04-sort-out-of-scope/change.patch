+  /**
+   * Lists active tasks. Ties on the sort key keep creation order (the repository
+   * returns creation order and Array#sort is stable), for both directions.
+   */
+  async list(options: ListTasksOptions = {}): Promise<Task[]> {
+    const tasks = await this.deps.repository.list(
+      options.status ? { status: options.status } : {},
+    );
+    const compare = compareBy(options.sort ?? "createdAt");
+    const direction = options.order === "desc" ? -1 : 1;
+    return tasks.sort((a, b) => direction * compare(a, b));
