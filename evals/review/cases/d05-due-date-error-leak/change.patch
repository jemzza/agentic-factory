diff --git a/tests/due-date.test.ts b/tests/due-date.test.ts
new file mode 100644
index 0000000..fd62c5d
--- /dev/null
+++ b/tests/due-date.test.ts
@@ -0,0 +1,60 @@
+import { describe, expect, it } from "vitest";
+import type { TaskDto } from "../src/domain/task.js";
+import { createTask, setup } from "./helpers.js";
+
+// FakeClock starts at 2026-01-01T00:00:00Z.
+
+async function overdueTitles(app: ReturnType<typeof setup>["app"], extra = "") {
+  const res = await app.inject({ method: "GET", url: `/tasks?overdue=true${extra}` });
+  expect(res.statusCode).toBe(200);
+  return res.json<{ items: TaskDto[] }>().items.map((t) => t.title);
+}
+
+describe("dueDate", () => {
+  it("defaults to null and can be set, changed and cleared", async () => {
+    const { app } = setup();
+    const created = await createTask(app, { title: "A", dueDate: "2026-02-01" });
+    expect(created.dueDate).toBe("2026-02-01");
+    const changed = await app.inject({
+      method: "PATCH",
+      url: `/tasks/${created.id}`,
+      payload: { dueDate: null },
+    });
+    expect(changed.json()).toMatchObject({ dueDate: null });
+    expect((await createTask(app, { title: "B" })).dueDate).toBeNull();
+  });
+
+  it.each(["2026-02-30", "2026-1-01", "tomorrow"])("rejects dueDate %s", async (dueDate) => {
+    const { app } = setup();
+    const res = await app.inject({ method: "POST", url: "/tasks", payload: { title: "A", dueDate } });
+    expect(res.statusCode).toBe(400);
+    expect(res.json()).toMatchObject({ error: { code: "VALIDATION_ERROR" } });
+  });
+});
+
+describe("GET /tasks?overdue=true", () => {
+  it("returns tasks due before today that are not done, using the app clock", async () => {
+    const { app, clock } = setup();
+    await createTask(app, { title: "past", dueDate: "2025-12-31" });
+    await createTask(app, { title: "today", dueDate: "2026-01-01" });
+    await createTask(app, { title: "past done", dueDate: "2025-12-01", status: "done" });
+    await createTask(app, { title: "none" });
+    expect(await overdueTitles(app)).toEqual(["past"]);
+    clock.advance(24 * 60 * 60 * 1000);
+    expect(await overdueTitles(app)).toEqual(["past", "today"]);
+  });
+
+  it("combines with status", async () => {
+    const { app } = setup();
+    await createTask(app, { title: "a", dueDate: "2025-12-31", status: "todo" });
+    await createTask(app, { title: "b", dueDate: "2025-12-31", status: "in_progress" });
+    expect(await overdueTitles(app, "&status=todo")).toEqual(["a"]);
+  });
+
+  it("rejects values other than true", async () => {
+    const { app } = setup();
+    const res = await app.inject({ method: "GET", url: "/tasks?overdue=false" });
+    expect(res.statusCode).toBe(400);
+    expect(res.json()).toMatchObject({ error: { code: "VALIDATION_ERROR" } });
+  });
+});
