diff --git a/tests/pagination.test.ts b/tests/pagination.test.ts
new file mode 100644
index 0000000..6d5e277
--- /dev/null
+++ b/tests/pagination.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from "vitest";
+import type { TaskDto } from "../src/domain/task.js";
+import { createTask, deleteTask, setup } from "./helpers.js";
+
+type Page = { items: TaskDto[]; nextCursor: string | null };
+
+async function getPage(app: ReturnType<typeof setup>["app"], query: string) {
+  const res = await app.inject({ method: "GET", url: `/tasks${query}` });
+  return { status: res.statusCode, body: res.json<Page>() };
+}
+
+async function seed(app: ReturnType<typeof setup>["app"], n: number) {
+  const ids: string[] = [];
+  for (let i = 0; i < n; i++) ids.push((await createTask(app, { title: `t${i}` })).id);
+  return ids;
+}
+
+describe("GET /tasks pagination", () => {
+  it("pages through all tasks with the default limit of 20", async () => {
+    const { app } = setup();
+    const ids = await seed(app, 25);
+    const first = await getPage(app, "");
+    expect(first.body.items).toHaveLength(20);
+    const second = await getPage(app, `?cursor=${first.body.nextCursor}`);
+    expect([...first.body.items, ...second.body.items].map((t) => t.id)).toEqual(ids);
+    expect(second.body.nextCursor).toBeNull();
+  });
+
+  it("returns nextCursor null when the last page is exactly full", async () => {
+    const { app } = setup();
+    await seed(app, 4);
+    const first = await getPage(app, "?limit=2");
+    const second = await getPage(app, `?limit=2&cursor=${first.body.nextCursor}`);
+    expect(second.body.items).toHaveLength(2);
+    expect(second.body.nextCursor).toBeNull();
+  });
+
+  it.each(["?limit=0", "?limit=101", "?limit=2.5", "?limit=x", "?cursor=bogus"])(
+    "rejects %s with 400 VALIDATION_ERROR",
+    async (query) => {
+      const { app } = setup();
+      const res = await getPage(app, query);
+      expect(res.status).toBe(400);
+    },
+  );
+});
