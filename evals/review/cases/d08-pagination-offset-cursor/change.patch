new file mode 100644
index 0000000..9077a5f
--- /dev/null
+++ b/src/services/cursor.ts
@@ -0,0 +1,26 @@
+import { z } from "zod";
+
+/**
+ * Opaque pagination cursor: base64url-encoded JSON `{ v: 1, after: <task id> }`.
+ * It points at the last task returned, so deleting or creating tasks between page
+ * requests never shifts the position (unlike an offset).
+ */
+const cursorPayloadSchema = z.strictObject({
+  v: z.literal(1),
+  after: z.string().min(1),
+});
+
+export function encodeCursor(afterId: string): string {
+  return Buffer.from(JSON.stringify({ v: 1, after: afterId }), "utf8").toString("base64url");
+}
+
+/** Returns the task id the cursor points after, or `null` if the cursor is malformed. */
+export function decodeCursor(cursor: string): string | null {
+  try {
+    const json: unknown = JSON.parse(Buffer.from(cursor, "base64url").toString("utf8"));
+    const parsed = cursorPayloadSchema.safeParse(json);
+    return parsed.success ? parsed.data.after : null;
+  } catch {
+    return null;
+  }
+}
