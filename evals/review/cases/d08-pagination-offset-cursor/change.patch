+  /**
+   * Returns one page of active tasks in creation order.
+   *
+   * The cursor references the last returned task. Positions are resolved against
+   * all tasks including soft-deleted ones, so the cursor stays valid even if that
+   * task is deleted before the next page is requested.
+   */
+  async listPage(input: ListPageInput = {}): Promise<TaskPage> {
+    const limit = input.limit ?? DEFAULT_PAGE_SIZE;
+    const all = await this.deps.repository.list();
+
+    let start = 0;
+    if (input.cursor !== undefined) {
+      const afterId = decodeCursor(input.cursor);
+      const index = afterId === null ? -1 : all.findIndex((t) => t.id === afterId);
+      if (index === -1) throw validationError("Invalid cursor");
+      start = index + 1;
+    }
+
+    const items: Task[] = [];
+    let hasMore = false;
+    for (let i = start; i < all.length; i++) {
+      const task = all[i]!;
+      if (isDeleted(task)) continue;
+      if (input.status !== undefined && task.status !== input.status) continue;
+      if (items.length === limit) {
+        hasMore = true;
+        break;
+      }
+      items.push(task);
+    }
+
+    const last = items.at(-1);
+    return { items, nextCursor: hasMore && last ? encodeCursor(last.id) : null };
