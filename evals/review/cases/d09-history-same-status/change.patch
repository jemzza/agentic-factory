diff --git a/tests/status-history.test.ts b/tests/status-history.test.ts
new file mode 100644
index 0000000..8097fcc
--- /dev/null
+++ b/tests/status-history.test.ts
@@ -0,0 +1,33 @@
+import { describe, expect, it } from "vitest";
+import { createTask, deleteTask, setup } from "./helpers.js";
+
+describe("GET /tasks/:id/history", () => {
+  it("records creation and every status change", async () => {
+    const { app, clock } = setup();
+    const created = await createTask(app, { title: "A" });
+    clock.advance(1000);
+    await app.inject({ method: "PATCH", url: `/tasks/${created.id}`, payload: { status: "done" } });
+    clock.advance(1000);
+    await app.inject({ method: "PATCH", url: `/tasks/${created.id}`, payload: { title: "B" } });
+
+    const res = await app.inject({ method: "GET", url: `/tasks/${created.id}/history` });
+    expect(res.statusCode).toBe(200);
+    expect(res.json()).toEqual({
+      items: [
+        { from: null, to: "todo", at: "2026-01-01T00:00:00.000Z" },
+        { from: "todo", to: "done", at: "2026-01-01T00:00:01.000Z" },
+      ],
+    });
+  });
+
+  it("returns 404 NOT_FOUND for deleted and unknown tasks", async () => {
+    const { app } = setup();
+    const created = await createTask(app);
+    await deleteTask(app, created.id);
+    for (const id of [created.id, "nope"]) {
+      const res = await app.inject({ method: "GET", url: `/tasks/${id}/history` });
+      expect(res.statusCode).toBe(404);
+      expect(res.json()).toMatchObject({ error: { code: "NOT_FOUND" } });
+    }
+  });
+});
