{
  "name": "agentic-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Software Factory: plan → implement → verify → review, with a human merging the result.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:sandbox": "vitest run --config vitest.integration.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "run-task": "tsx src/cli.ts run",
    "eval": "tsx src/cli.ts eval",
    "verify-hidden": "tsx src/cli.ts verify-hidden",
    "eval:rescore": "tsx src/cli.ts eval-rescore",
    "project:check": "tsx src/cli.ts project-check",
    "factory:watch": "tsx src/cli.ts watch",
    "memory": "tsx src/cli.ts memory",
    "smoke:claude": "tsx scripts/smoke-claude.ts",
    "runs": "tsx src/cli.ts runs",
    "resume": "tsx src/cli.ts resume",
    "approve": "tsx src/cli.ts approve",
    "reject": "tsx src/cli.ts reject",
    "merge": "tsx src/cli.ts merge",
    "close": "tsx src/cli.ts close",
    "baseline:update": "tsx src/cli.ts baseline-update",
    "reopen-merge": "tsx src/cli.ts reopen-merge",
    "eval:review": "tsx src/cli.ts eval-review",
    "eval:memory": "tsx src/cli.ts eval-memory",
    "dashboard": "tsx src/cli.ts dashboard",
    "db:import": "tsx src/cli.ts db-import"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.14.2",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.0",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "better-sqlite3": "12.11.1",
    "execa": "^10.1.1",
    "fastify": "5.12.5",
    "mem0ai": "3.3.1",
    "ollama": "0.5.18",
    "opencode-ai": "1.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
