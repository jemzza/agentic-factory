{
  "name": "agentic-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Software Factory: plan → implement → verify → review, with a human merging the result.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:sandbox": "vitest run --config vitest.integration.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "run-task": "tsx src/cli.ts run",
    "eval": "tsx src/cli.ts eval",
    "verify-hidden": "tsx src/cli.ts verify-hidden"
  },
  "dependencies": {
    "execa": "^10.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
